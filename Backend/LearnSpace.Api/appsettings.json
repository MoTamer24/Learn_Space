{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/learnspace-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/warnings-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/errors-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=learnspace;Username=learnspace;Password=learnspace_dev"
  },
  "Jwt": {
    "Key": "DEV-ONLY-REPLACE-ME-with-a-long-random-secret-of-at-least-32-characters",
    "Issuer": "LearnSpace",
    "Audience": "LearnSpace.Client"
  },
  "Storage": {
    "RootPath": "storage",
    "Uploads": {
      "Video":    { "Extensions": [ ".mp4" ],                     "MaxMb": 200 },
      "Document": { "Extensions": [ ".pdf", ".docx", ".pptx" ],   "MaxMb": 20 },
      "TaskFile": { "Extensions": [ ".pdf", ".jpg", ".png", ".docx" ], "MaxMb": 20 },
      "Logo":     { "Extensions": [ ".jpg", ".png" ],             "MaxMb": 2 }
    }
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  }
}
